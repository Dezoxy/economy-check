# economy-check secrets — copy to .env (gitignored) and fill in.
# .env is parsed by shared/fetchers/base.py (KEY=VALUE lines, # comments ok).

# --- REQUIRED for the weekly report (fred + econ_calendar sources) ---
# Free key: https://fred.stlouisfed.org  (My Account -> API Keys)
FRED_API_KEY=

# --- Delivery (step E/G: telegram + email) ---
# Create a bot with @BotFather; chat id via @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP for email delivery (465 = SSL, 587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=me@toomhorvath.com

# --- Optional ---
# CoinGecko demo key lifts rate limits (works without it)
COINGECKO_API_KEY=
# SoSoValue key enables the etf_flows fallback source
SOSOVALUE_API_KEY=
